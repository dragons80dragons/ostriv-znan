# Проміжне й те, що збирається заново

# Сирі картинки з ComfyUI (по 1 МБ кожна) — з них роблять assets/img
tools/_raw/
# Сирий трек ACE-Step і конфіг генерації
tools/_music/
# Кадри краба з AnimateDiff (по 16 на настрій, з фоном). У грі вони вже
# не використовуються — краб складається з частин assets/krab, — але
# генератор лишився, тож хай сміття з нього сюди й не потрапляє.
tools/_anim/
tools/_ref/_unused/
# Зразки всіх 31 голосу (14 МБ) — потрібні були один раз, щоб вибрати голос
tools/voice_samples/
# Оглядові аркуші, прев'ю іконок, QR — усе будується скриптами
tools/_sheet*.png
tools/_icons_preview.png
tools/_qr*.png

# Збірка однією сторінкою: 6 МБ, робиться tools/build_single.py за 7 хв
ostriv-znan-один-файл.html
# Готові файли для роздачі
_для диску/

# Результати уроків — це дані класу, не код
teacher/results.jsonl

# Копія index.html перед великою переробкою — лежить поруч, щоб було куди
# відкотитись; в історії для цього є git
tools/_index_backup_*.html

# Службове
desktop.ini
Thumbs.db
__pycache__/

# ...крім того, що дає теці «на флешку» її іконку: це вже джерело збірки
!flash/desktop.ini

# ---------------------------------------------------------------------------
# Видобуті тексти підручників. У кожному файлі першим рядком стоїть: «Право
# для безоплатного розміщення підручника в мережі Інтернет має Міністерство
# освіти і науки України та Інститут модернізації змісту освіти». Отже
# викладати їх у ВІДКРИТИЙ репозиторій не можна — це розміщення в мережі
# того, на що право має не ми. Для роботи вони й не потрібні в хмарі: це
# джерело, з якого складали уроки, а не частина гри. Хто захоче читати їх
# разом із нами — бере свою копію з Диску, де вона приватна.
# txt_raw до того ж проміжне: робиться з PDF заново.
програма-1-клас/робоче/txt/
програма-1-клас/робоче/txt_raw/
програма-1-клас/робоче/txt_avtorski/

# Журнал генерації: 2,5 МБ і росте щогодини, в історії від нього користі нема
програма-1-клас/робоче/*.log

# Копії перед правкою — для цього і є історія
tools/*.bak-*
